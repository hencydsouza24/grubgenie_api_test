# Real credentials that must NOT be committed. Copy this file to `credentials.env` (same
# directory — gitignored) and fill in the real values. Only needed for these commands:
#   pos.sh config setup       — requires GG_PETPOOJA_APP_SECRET / GG_PETPOOJA_ACCESS_TOKEN
#   admin auth (gg_admin_token/Get-GgCachedAdminToken) — requires GG_ADMIN_EMAIL / GG_ADMIN_PASSWORD
#   admin_misc.sh waba resolve-*, misc_tools.sh agents topic — requires GG_WABA_MIDDLEWARE_API_KEY
#   misc_tools.sh voice-webhook               — requires GG_VOICE_TOOL_KEY
#   reservation.sh embed                      — requires GG_WIDGET_EMBED_KEY
# Every other command (auth, cart, order, flow, menu browsing, pos menu/items/sync/validate)
# works with zero setup against the shared munch2 test tenant.

# Petpooja test-sandbox secret pair. Ask a teammate or check the Petpooja partner dashboard for
# the munch2 test restaurant. appKey and restId are NOT secret and already live in
# scripts/lib/constants.sh — only these two need to stay out of the tracked tree.
GG_PETPOOJA_APP_SECRET=
GG_PETPOOJA_ACCESS_TOKEN=

# GrubGenie admin account (hello@grubgenie.ai on the test tenant). Grants cross-tenant access —
# ask a teammate for the current password rather than guessing or reusing an old one.
GG_ADMIN_EMAIL=hello@grubgenie.ai
GG_ADMIN_PASSWORD=

# WABA middleware service-account key — sent as the X-Api-Key header for admin/waba/resolve-*
# and the agents-module knowledge-base topic lookup. Ask a teammate for the current value.
GG_WABA_MIDDLEWARE_API_KEY=

# Per-partner secret path segment for the voice tool webhook (GET /v1/voice/tools/:toolKey/:tool)
# — not a header, the key itself IS the auth, embedded directly in the URL. Ask a teammate.
GG_VOICE_TOOL_KEY=

# Reservation-widget embed key — sent as the X-Api-Key header for GET /v1/partner/reservation-widget/embed
# (this is what an external website embedding the widget would actually hold). Ask a teammate.
GG_WIDGET_EMBED_KEY=
