# Real credentials that must NOT be committed. Copy this file to `credentials.env` (same
# directory — gitignored) and fill in the real values. Only needed for two commands:
#   pos.sh config setup   — requires GG_PETPOOJA_APP_SECRET / GG_PETPOOJA_ACCESS_TOKEN
#   admin auth            — requires GG_ADMIN_EMAIL / GG_ADMIN_PASSWORD
# Every other command (auth, cart, order, flow, menu browsing, pos menu/items/sync/validate)
# works with zero setup against the shared munch2 test tenant.

# Petpooja test-sandbox secret pair. Ask a teammate or check the Petpooja partner dashboard for
# the munch2 test restaurant. appKey and restId are NOT secret and already live in
# scripts/lib/constants.sh — only these two need to stay out of the tracked tree.
GG_PETPOOJA_APP_SECRET=
GG_PETPOOJA_ACCESS_TOKEN=

# GrubGenie admin account (hello@grubgenie.ai on the test tenant). Grants cross-tenant access —
# ask a teammate for the current password rather than guessing or reusing an old one.
GG_ADMIN_EMAIL=hello@grubgenie.ai
GG_ADMIN_PASSWORD=
